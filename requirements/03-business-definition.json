  "businessStateMachine": {
    "authoritativeSource": "Business-owned candidate lifecycle for Gate 4; aligned with Gate 2 state machine contract.",
    "states": [
      {
        "state": "NEW",
        "owner": "HR Recruiter",
        "type": "draft",
        "entry": "Candidate creation started",
        "next": [
          "IMPORTED",
          "WITHDRAWN"
        ]
      },
      {
        "state": "IMPORTED",
        "owner": "System",
        "type": "active",
        "entry": "Valid candidate/job input imported",
        "next": [
          "SCREENING_RUNNING",
          "ERROR",
          "WITHDRAWN"
        ]
      },
      {
        "state": "SCREENING_RUNNING",
        "owner": "System",
        "type": "active",
        "entry": "JD and CV available",
        "next": [
          "SCREENING_PENDING_APPROVAL",
          "ERROR",
          "WITHDRAWN"
        ]
      },
      {
        "state": "SCREENING_PENDING_APPROVAL",
        "owner": "HR Manager",
        "type": "approval",
        "entry": "Screening result generated",
        "next": [
          "SCREENED_IN",
          "SCREENED_OUT",
          "SCREENING_RUNNING",
          "WITHDRAWN"
        ]
      },
      {
        "state": "SCREENED_IN",
        "owner": "System",
        "type": "active",
        "entry": "HR Manager approves screening",
        "next": [
          "AVAILABILITY_PENDING",
          "WITHDRAWN"
        ]
      },
      {
        "state": "SCREENED_OUT",
        "owner": "HR Manager",
        "type": "terminal",
        "entry": "HR Manager rejects screening",
        "next": []
      },
      {
        "state": "AVAILABILITY_PENDING",
        "owner": "Candidate / Interviewer",
        "type": "active",
        "entry": "Candidate screened in",
        "next": [
          "SCHEDULING_PENDING_APPROVAL",
          "ERROR",
          "WITHDRAWN"
        ]
      },
      {
        "state": "SCHEDULING_PENDING_APPROVAL",
        "owner": "HR Manager",
        "type": "approval",
        "entry": "Valid interview slots generated",
        "next": [
          "INTERVIEW_SCHEDULED",
          "AVAILABILITY_PENDING",
          "WITHDRAWN"
        ]
      },
      {
        "state": "INTERVIEW_SCHEDULED",
        "owner": "System",
        "type": "active",
        "entry": "HR Manager approves slot",
        "next": [
          "AI_INTERVIEW_PENDING",
          "WITHDRAWN",
          "ERROR"
        ]
      },
      {
        "state": "AI_INTERVIEW_PENDING",
        "owner": "Candidate",
        "type": "active",
        "entry": "Interview link sent",
        "next": [
          "AI_INTERVIEW_COMPLETED",
          "WITHDRAWN",
          "ERROR"
        ]
      },
      {
        "state": "AI_INTERVIEW_COMPLETED",
        "owner": "System",
        "type": "active",
        "entry": "Candidate submits async interview",
        "next": [
          "TEST_PENDING",
          "FINAL_REVIEW",
          "ERROR"
        ]
      },
      {
        "state": "TEST_PENDING",
        "owner": "Candidate",
        "type": "active",
        "entry": "Test assigned",
        "next": [
          "TEST_GRADED",
          "WITHDRAWN",
          "ERROR"
        ]
      },
      {
        "state": "TEST_GRADED",
        "owner": "System",
        "type": "active",
        "entry": "Test sections graded",
        "next": [
          "FINAL_REVIEW",
          "ERROR"
        ]
      },
      {
        "state": "FINAL_REVIEW",
        "owner": "HR Manager",
        "type": "approval",
        "entry": "Evidence package ready",
        "next": [
          "PASSED",
          "FAILED",
          "WITHDRAWN"
        ]
      },
      {
        "state": "PASSED",
        "owner": "HR Manager",
        "type": "terminal",
        "entry": "Final pass decision recorded",
        "next": []
      },
      {
        "state": "FAILED",
        "owner": "HR Manager",
        "type": "terminal",
        "entry": "Final fail decision recorded",
        "next": []
      },
      {
        "state": "WITHDRAWN",
        "owner": "Candidate / HR Recruiter / HR Manager",
        "type": "terminal",
        "entry": "Candidate withdraws or HR marks withdrawn",
        "next": []
      },
      {
        "state": "ERROR",
        "owner": "IT Admin / HR Recruiter",
        "type": "remediation",
        "entry": "Blocking technical or data issue",
        "next": [
          "previous_valid_state",
          "WITHDRAWN"
        ]
      }
    ]
  },
  "exceptionPaths": [
    {
      "bpId": "BP-001",
      "exceptions": [
        "invalid file",
        "invalid row",
        "duplicate candidate",
        "Drive import failure"
      ],
      "owner": "HR Recruiter / IT Admin",
      "resolution": "valid rows proceed; exceptions assigned for correction, merge/skip/create-new, or retry"
    },
    {
      "bpId": "BP-002",
      "exceptions": [
        "unreadable CV",
        "scanned file",
        "low AI confidence",
        "LLM failure"
      ],
      "owner": "HR Manager / IT Admin",
      "resolution": "manual review, re-screen, reject unsupported file, or technical retry"
    },
    {
      "bpId": "BP-003",
      "exceptions": [
        "no valid slots",
        "candidate no response",
        "Calendar unavailable",
        "post-approval reschedule needed"
      ],
      "owner": "HR Manager",
      "resolution": "request alternative availability, manual scheduling fallback, or reschedule policy once defined"
    },
    {
      "bpId": "BP-004",
      "exceptions": [
        "expired link",
        "incomplete submission",
        "AI evaluation uncertain"
      ],
      "owner": "HR Recruiter / HR Manager",
      "resolution": "reopen link, manual review, or mark withdrawn/error"
    },
    {
      "bpId": "BP-005",
      "exceptions": [
        "test timeout",
        "grading failure",
        "coding sandbox error",
        "plagiarism flag"
      ],
      "owner": "HR Manager / IT Admin",
      "resolution": "re-grade, manual override, technical remediation, or final review exception"
    },
    {
      "bpId": "BP-006",
      "exceptions": [
        "incomplete evidence package",
        "conflicting scores",
        "override needed"
      ],
      "owner": "HR Manager",
      "resolution": "request missing evidence, record override reason, or defer final decision"
    },
    {
      "bpId": "BP-009",
      "exceptions": [
        "ambiguous withdrawal request",
        "withdrawal after scheduled interview"
      ],
      "owner": "HR Recruiter",
      "resolution": "confirm request, notify stakeholders, close pending actions"
    },
    {
      "bpId": "BP-010",
      "exceptions": [
        "unassigned error",
        "repeated retry failure",
        "integration outage"
      ],
      "owner": "IT Admin",
      "resolution": "assign owner, escalate, fallback to manual process"
    }
  ],
  "handoffMatrix": [
    {
      "from": "BP-001",
      "to": "BP-002",
      "signal": "Candidate IMPORTED and JD available",
      "payload": "candidate profile, CV text/file, JD"
    },
    {
      "from": "BP-002",
      "to": "BP-003",
      "signal": "Candidate SCREENED_IN",
      "payload": "approved screening result and candidate context"
    },
    {
      "from": "BP-003",
      "to": "BP-004",
      "signal": "Candidate INTERVIEW_SCHEDULED or interview stage reached",
      "payload": "candidate profile, JD, interview template, language"
    },
    {
      "from": "BP-004",
      "to": "BP-005",
      "signal": "Candidate AI_INTERVIEW_COMPLETED and test required",
      "payload": "interview transcript, AI evaluation, assigned test"
    },
    {
      "from": "BP-005",
      "to": "BP-006",
      "signal": "Candidate TEST_GRADED",
      "payload": "test report, interview report, screening result"
    },
    {
      "from": "any active BP",
      "to": "BP-009",
      "signal": "Candidate withdrawal request or HR withdrawal action",
      "payload": "candidate, current state, reason if available"
    },
    {
      "from": "any active BP",
      "to": "BP-010",
      "signal": "Blocking ERROR state",
      "payload": "candidate/job, prior state, error reason, owning integration/process"
    }
  ]
}
