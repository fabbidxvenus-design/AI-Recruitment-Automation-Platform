  "businessRules": [
    {
      "id": "BR-001",
      "name": "Human approval is mandatory at business decision gates",
      "type": "governance",
      "rule": "Screening shortlist, schedule confirmation, and final pass/fail decisions must be approved by HR Manager or designated backup.",
      "tracesTo": [
        "REQ-F-017",
        "REQ-F-023",
        "REQ-F-051",
        "REQ-F-054"
