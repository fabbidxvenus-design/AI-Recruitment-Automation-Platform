    },
    {
      "id": "BR-002",
      "name": "Approval reminders do not imply auto-action",
      "type": "governance",
      "rule": "Pending approvals may trigger reminders and escalation, but must not auto-approve, auto-reject, auto-cancel, or auto-skip.",
      "tracesTo": [
        "REQ-F-053",
        "REQ-F-054"
      ]
    },
    {
      "id": "BR-003",
      "name": "Duplicate candidates require HR review",
      "type": "data-quality",
      "rule": "Candidate records with matching email or phone must be flagged for merge/skip/create-new decision.",
